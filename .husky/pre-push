#!/bin/sh

# shellcheck disable=SC1091
. "$(dirname "$0")/common.sh"

# Check the yarn lockfile is up to date
echo "📦 Pre-push: Checking yarn lockfile..."
yarn install --immutable

# Find the base branch (try common names in order)
BASE_BRANCH=""
for branch in origin/main origin/5.x main 5.x; do
  if git rev-parse --verify "$branch" >/dev/null 2>&1; then
    BASE_BRANCH="$branch"
    break
  fi
done

if [ -z "$BASE_BRANCH" ]; then
  echo "⚠️  Warning: Could not determine base branch, defaulting to origin/main"
  BASE_BRANCH="origin/main"
fi

echo "🔍 Pre-push: Detected base branch: $BASE_BRANCH"

# Get merge base (where this branch diverged)
MERGE_BASE=$(git merge-base HEAD "$BASE_BRANCH")

# Get all changed files since branching (Added, Copied, Modified, Renamed)
CHANGED_FILES=$(git diff --name-only --diff-filter=ACMR "$MERGE_BASE")

if [ -z "$CHANGED_FILES" ]; then
  echo "✅ No files changed since branching from $BASE_BRANCH"
else
  echo "📝 Files changed since branching:"
  echo "$CHANGED_FILES" | head -n 10
  FILE_COUNT=$(echo "$CHANGED_FILES" | wc -l | tr -d ' ')
  if [ "$FILE_COUNT" -gt 10 ]; then
    echo "... and $((FILE_COUNT - 10)) more files"
  fi
  
  # Stage the changed files temporarily for lint-staged to process
  echo "$CHANGED_FILES" | xargs git add --intent-to-add 2>/dev/null || true
  
  # Run comprehensive lint-staged with tests on all changed files
  echo "🔍 Pre-push: Running comprehensive lint, format, and tests on changed files..."
  yarn lint-staged --config lint-staged.pre-push.config.cjs --diff="$MERGE_BASE"
fi

# Check .ai/ docs are up to date with source content
# Only run if content, stories, meta, or token source changed
AI_RELEVANT=$(echo "$CHANGED_FILES" | grep -E '(apps/guidelines/content/|\.stories\.tsx|/meta/index\.tsx|packages/tokens/src/)' || true)
if [ -n "$AI_RELEVANT" ]; then
  echo "🤖 Pre-push: Checking .ai/ docs are up to date..."
  yarn translate --tokens --components --llms-txt 2>/dev/null
  AI_DIFF=$(git diff --name-only -- 'packages/components/.ai/' 'packages/tokens/.ai/' 'packages/components/llms.txt' 'packages/tokens/llms.txt')
  if [ -n "$AI_DIFF" ]; then
    echo ""
    echo "❌ .ai/ docs are stale! The following files changed after running yarn translate:"
    echo "$AI_DIFF" | sed 's/^/   /'
    echo ""
    echo "   Fix: run 'yarn translate' and commit the changes."
    echo ""
    exit 1
  fi
  echo "✅ .ai/ docs are up to date"
fi

# Check docs/ has been rebuilt when guidelines source changes
GUIDELINES_CHANGED=$(echo "$CHANGED_FILES" | grep -E '^apps/guidelines/' || true)
DOCS_CHANGED=$(echo "$CHANGED_FILES" | grep -E '^docs/' || true)
if [ -n "$GUIDELINES_CHANGED" ] && [ -z "$DOCS_CHANGED" ]; then
  echo ""
  echo "❌ apps/guidelines/ has changes but docs/ has not been updated."
  echo "   Run 'yarn workspace @iress/ids-guidelines run build' and commit docs/."
  echo ""
  exit 1
fi
if [ -n "$GUIDELINES_CHANGED" ] && [ -n "$DOCS_CHANGED" ]; then
  echo "✅ docs/ has been updated alongside guidelines changes"
fi

# Check there are no commits with secrets before pushing
ggshield secret scan pre-push "$@"
