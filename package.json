{
  "name": "@iress/design-system-monorepo",
  "version": "0.0.0-development",
  "author": "Iress",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "resolutions": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@vitest/mocker": "^4.1.12",
    "axios": "^1.21.0",
    "body-parser": "^2.4.0",
    "brace-expansion@npm:^5.0.5": "5.0.12",
    "browserslist": "^4.28.7",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.9",
    "follow-redirects": "^1.16.2",
    "hono": "^4.13.11",
    "ip-address": "^10.7.4",
    "joi": "^18.2.9",
    "katex": "^0.18.2",
    "minimatch": "^11.0.1",
    "picomatch@npm:4.0.3": "4.0.4",
    "picomatch@npm:^4.0.2": "^4.0.4",
    "picomatch@npm:^4.0.3": "^4.0.4",
    "postcss": "^8.5.23",
    "postcss-selector-parser@npm:^6.1.2": "6.1.5",
    "postcss-selector-parser@npm:7.1.1": "7.1.6",
    "postcss-selector-parser@npm:^7.1.0": "^7.1.6",
    "postcss-selector-parser@npm:^7.1.1": "^7.1.6",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.1",
    "shell-quote": "^1.12.0",
    "source-map-js": "^1.2.2",
    "undici@npm:^6.25.0": "6.29.1",
    "undici@npm:^7.25.0": "^7.30.1",
    "vite@npm:^6.0.0 || ^7.0.0 || ^8.0.0": "8.3.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@iress-oss/ids-components": "^6.4.7",
    "@iress-oss/ids-storybook-config": "^0.6.0",
    "@iress-oss/ids-storybook-okta": "^0.1.2",
    "@iress-oss/ids-storybook-sandbox": "^0.2.2",
    "@iress-oss/ids-storybook-toggle-stories": "^0.1.0",
    "@iress-oss/ids-storybook-version-badge": "^0.1.1",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@size-limit/file": "12.1.0",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitest/mocker": "4.1.12",
    "@vueless/storybook-dark-mode": "10.0.8",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "concurrently": "^10.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-file-progress": "^4.0.0",
    "eslint-plugin-mdx": "3.8.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-sonarjs": "^4.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pinst": "^3.0.0",
    "prettier": "^3.8.2",
    "puppeteer": "^25.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "size-limit": "12.1.0",
    "storybook": "10.6.5",
    "storybook-addon-tag-badges": "^3.1.0",
    "ts-dedent": "^2.2.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "8.3.5",
    "wait-on": "^9.0.10",
    "ws": "^8.21.3",
    "zx": "^8.8.5"
  },
  "scripts": {
    "build": "yarn monorepo run build && yarn translate",
    "check-coverage": "tsx ./scripts/check-coverage.ts",
    "size": "size-limit",
    "size:check": "size-limit --json",
    "dev": "concurrently \"wait-on tcp:6006 && wait-on tcp:6007 && yarn storybook\" \"yarn packages/components dev:no-open\" \"yarn packages/tokens dev:no-open\"",
    "dev:kill": "kill $(lsof -ti tcp:6005) || true; kill $(lsof -ti tcp:6006) || true; kill $(lsof -ti tcp:6007) || true",
    "prepublish": "tsx ./scripts/storybook-addon-prepublish.ts",
    "prepare": "husky && yarn build",
    "build-storybook": "storybook build",
    "storybook": "storybook dev -p 6005",
    "storybook:serve-addon": "tsx ./scripts/storybook-addon-server.ts",
    "lint": "yarn monorepo run lint",
    "lint:mermaid": "tsx ./scripts/lint-mermaid.ts",
    "test": "yarn monorepo run test",
    "test:coverage": "yarn monorepo run test:coverage",
    "test:ci": "yarn test:coverage && yarn check-coverage --all",
    "translate": "yarn translate:components && yarn generate:token-reference && yarn translate:skills && yarn generate:llms-txt",
    "translate:components": "tsx ./scripts/translate-components.ts",
    "translate:skills": "tsx ./scripts/translate-skills.ts",
    "generate:token-reference": "tsx ./scripts/generate-token-reference.ts",
    "generate:llms-txt": "tsx ./scripts/generate-llms-txt.ts",
    "components:versions": "tsx ./scripts/generate-component-versions.ts",
    "typecheck": "yarn monorepo run typecheck",
    "monorepo": "yarn workspaces foreach -Ai --topological-dev --exclude=@iress/design-system-monorepo"
  }
}
