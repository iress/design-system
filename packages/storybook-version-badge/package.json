{
  "name": "@iress-oss/ids-storybook-version-badge",
  "version": "0.1.1",
  "description": "A Storybook addon that displays the current version of your design system in the Storybook toolbar.",
  "keywords": [
    "storybook-addons"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "author": "Iress",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manager": "./dist/manager.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts"
  ],
  "scripts": {
    "build": "yarn clean && tsup",
    "clean": "rimraf dist",
    "dev": "concurrently \"yarn watch\" \"yarn serve\"",
    "lint": "eslint . --ext=.js,.jsx,.ts,.tsx,.mjs,.cjs,.mdx --max-warnings=0",
    "test": "vitest --config vitest.config.ts --watch",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "serve": "yarn storybook:serve-addon packages/storybook-version-badge",
    "watch": "tsup --watch"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.3.6",
    "@storybook/react-vite": "10.3.6",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.5.0",
    "eslint-plugin-file-progress": "^4.0.0",
    "eslint-plugin-mdx": "3.8.1",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rimraf": "6.1.3",
    "storybook": "10.3.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "8.0.11",
    "vitest": "4.1.5"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "storybook": "^10"
  },
  "bundler": {
    "managerEntries": [
      "src/manager.tsx",
      "src/index.ts"
    ],
    "previewEntries": [
      "src/index.ts"
    ]
  },
  "storybook": {
    "displayName": "Storybook Version Badge",
    "icon": "https://user-images.githubusercontent.com/321738/63501763-88dbf600-c4cc-11e9-96cd-94adadc2fd72.png"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iress/design-system"
  }
}
