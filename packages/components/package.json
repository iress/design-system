{
  "name": "@iress-oss/ids-components",
  "version": "6.1.0",
  "description": "Iress React Component Library",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "files": [
    ".ai",
    "dist",
    "llms.txt"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "yarn panda:prepare && yarn components:versions && vite build",
    "build-storybook": "yarn components:versions && storybook build --stats-json",
    "clean": "rimraf dist coverage src/styled-system",
    "dev": "concurrently \"yarn workspace @iress-oss/ids-theme-preset dev\" \"yarn panda:watch\" \"yarn storybook\"",
    "dev:no-open": "concurrently \"yarn workspace @iress-oss/ids-theme-preset dev\" \"yarn panda:watch\" \"yarn storybook --no-open\"",
    "lint": "eslint . --max-warnings 0",
    "panda:prepare": "panda cssgen && panda codegen",
    "panda:watch": "panda --watch",
    "storybook": "yarn components:versions && storybook dev -p 6006",
    "test": "vitest --config vitest.config.ts --watch",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:ui": "vitest --config vitest.config.ts --ui",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json"
  },
  "devDependencies": {
    "@iress-oss/ids-theme-preset": "^6.0.0",
    "@iress-oss/ids-tokens": "^6.0.0",
    "@pandacss/dev": "1.9.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/dompurify": "3.2.0",
    "@types/jest-axe": "3.5.9",
    "@types/query-selector-shadow-dom": "1.0.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.5",
    "@vitest/ui": "4.1.5",
    "concurrently": "^9.2.1",
    "dompurify": "^3.4.11",
    "eslint": "10.6.0",
    "eslint-plugin-file-progress": "^4.0.0",
    "eslint-plugin-mdx": "3.8.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-sonarjs": "^4.0.3",
    "glob": "13.0.6",
    "jest-axe": "10.0.0",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "postcss": "8.5.17",
    "prettier": "^3.8.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-dropzone": "15.0.0",
    "react-hook-form": "7.72.1",
    "rimraf": "^6.1.3",
    "storybook": "10.4.6",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-dts": "5.0.0",
    "vite-plugin-static-copy": "4.1.0",
    "vitest": "4.1.5"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.19",
    "@fortawesome/fontawesome-common-types": "0.2.36",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.13.12",
    "@types/mdx": "^2.0.13",
    "fuzzysort": "3.1.0",
    "material-symbols": "0.45.6",
    "query-selector-shadow-dom": "1.0.1",
    "use-debounce": "10.1.1"
  },
  "peerDependencies": {
    "react": "^17 || ^18 || ^19",
    "react-dom": "^17 || ^18 || ^19",
    "react-hook-form": "^7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iress/design-system"
  }
}
