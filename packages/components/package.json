  "dependencies": {
    "@floating-ui/react": "0.27.17",
    "@tanstack/react-table": "8.21.3",
    "classnames": "2.5.1",
    "fuzzysort": "3.1.0",
    "query-selector-shadow-dom": "1.0.1",
    "react-hook-form": "7.53.1",
    "use-debounce": "10.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iress/design-system"
  }
