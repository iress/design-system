{
  "name": "@iress-oss/ids-tokens",
  "version": "6.0.0-beta.2",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./build/css-vars.css": "./build/css-vars.css",
    "./convertReferencesToVariables": "./dist/helpers/convertReferencesToVariables.js",
    "./mapTokensToCssVariables": "./dist/helpers/mapTokensToCssVariables.js",
    "./transforms": "./dist/transforms/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    ".ai",
    "build",
    "dist",
    "llms.txt"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "analyse": "yarn vite-bundle-visualizer",
    "build": "yarn cssVars && vite build",
    "build-storybook": "storybook build --stats-json",
    "dev": "concurrently \"yarn watch:cssVars\" \"yarn storybook\"",
    "dev:no-open": "concurrently \"yarn watch:cssVars\" \"yarn storybook --no-open\"",
    "clean": "rimraf build dist coverage src/generated storybook-static",
    "cssVars": "tsx plugins/generateCssVars.ts",
    "lint": "eslint . --ext=.js,.jsx,.ts,.tsx,.mjs,.cjs,.mdx --max-warnings=0",
    "storybook": "storybook dev -p 6007",
    "test": "vitest --config vitest.config.ts --watch",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "watch": "vite build --watch",
    "watch:cssVars": "nodemon --watch src --ignore src/generated --ext ts --exec yarn cssVars"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "chalk": "^5.6.2",
    "colorjs.io": "^0.6.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.0",
    "eslint-plugin-file-progress": "^4.0.0",
    "eslint-plugin-mdx": "3.7.0",
    "eslint-plugin-prettier": "^5.5.5",
    "jsdom": "^29.1.1",
    "json5": "^2.2.3",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.2",
    "radash": "^12.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.1.3",
    "rollup-plugin-tree-shakeable": "^2.0.0",
    "storybook": "10.3.6",
    "style-dictionary": "^5.4.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "8.0.11",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "4.1.5"
  },
  "peerDependencies": {
    "radash": "^12.1.0",
    "style-dictionary": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "radash": {
      "optional": true
    },
    "style-dictionary": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iress/design-system"
  },
  "stableVersion": "6.0.0-alpha.2"
}
