{
  "name": "@iress-oss/ids-storybook-config",
  "version": "0.6.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./manager": {
      "types": "./dist/manager.d.ts",
      "import": "./dist/manager.js"
    }
  },
  "files": [
    "dist",
    "public"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "analyse": "yarn vite-bundle-visualizer",
    "build": "vite build",
    "dev": "yarn storybook",
    "clean": "rimraf dist coverage storybook-static",
    "lint": "eslint . --ext=.js,.jsx,.ts,.tsx,.mjs,.cjs,.mdx --max-warnings=0",
    "storybook": "storybook dev -p 6006",
    "test": "vitest --config vitest.config.ts --watch",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "watch": "vite build --watch"
  },
  "dependencies": {
    "@iress-oss/ids-tokens": "^6.0.0",
    "radash": "12.1.1",
    "react-diff-viewer": "^3.1.1",
    "react-element-to-jsx-string": "^17.0.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.1",
    "@iress-oss/ids-components": "^6.0.0",
    "@iress-oss/ids-storybook-okta": "^0.1.2",
    "@iress-oss/ids-storybook-sandbox": "^0.2.2",
    "@iress-oss/ids-storybook-toggle-stories": "^0.1.0",
    "@iress-oss/ids-storybook-version-badge": "^0.1.1",
    "@mdx-js/react": "3.1.1",
    "@storybook/addon-a11y": "10.3.6",
    "@storybook/addon-docs": "10.3.6",
    "@storybook/addon-links": "10.3.6",
    "@storybook/react-vite": "10.3.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "@types/react-is": "^19",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "@vueless/storybook-dark-mode": "10.0.8",
    "chalk": "^5.6.2",
    "colorjs.io": "^0.6.1",
    "eslint": "^10.2.0",
    "eslint-plugin-file-progress": "^4.0.0",
    "eslint-plugin-mdx": "3.7.0",
    "eslint-plugin-prettier": "^5.5.5",
    "happy-dom": "20.9.0",
    "jsdom": "^29.1.1",
    "json5": "^2.2.3",
    "prettier": "^3.8.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-is": "^19.2.6",
    "rimraf": "^6.1.3",
    "rollup-plugin-tree-shakeable": "^2.0.0",
    "storybook": "10.3.6",
    "storybook-addon-tag-badges": "^3.1.0",
    "typescript": "^6.0.3",
    "vite": "8.0.14",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-dts": "^5.0.1",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "4.1.5"
  },
  "peerDependencies": {
    "@chromatic-com/storybook": "^4 || ^5",
    "@iress-oss/ids-components": "^6",
    "@iress-oss/ids-storybook-okta": "^0",
    "@iress-oss/ids-storybook-sandbox": "^0.2",
    "@iress-oss/ids-storybook-toggle-stories": "^0",
    "@iress-oss/ids-storybook-version-badge": "^0",
    "@storybook/addon-a11y": "^10",
    "@storybook/addon-docs": "^10",
    "@storybook/react-vite": "^10",
    "@vueless/storybook-dark-mode": "^10",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "storybook": "^10",
    "storybook-addon-tag-badges": "^3",
    "vite": "^8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iress/design-system"
  }
}
