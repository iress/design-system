{
  "name": "@iress-oss/ids-mcp-server",
  "version": "6.0.0-alpha.29",
  "description": "Model Context Protocol (MCP) server for Iress Design System (IDS) component library - provides AI assistants with contextual information about IDS components, design tokens, and usage patterns",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "ids": "dist/index.js"
  },
  "private": true,
  "keywords": [
    "mcp",
    "model-context-protocol",
    "iress",
    "design-system",
    "component-library",
    "ui",
    "react",
    "ai-assistant"
  ],
  "author": "Iress",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf coverage dist",
    "collect": "tsx scripts/collect.ts",
    "dev": "mcp-inspector tsx src/index.ts",
    "dev:kill": "kill $(lsof -ti tcp:6277) || true; kill $(lsof -ti tcp:6274) || true",
    "generate": "tsx scripts/generate.ts",
    "guidelines": "tsx scripts/guidelines.ts",
    "lint": "npx eslint . --max-warnings 0",
    "test": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "generated/docs/**/*",
    "README.md",
    "LICENSE.txt"
  ],
  "dependencies": {
    "@iress-oss/ids-tokens": "^6.0.0-alpha.15",
    "@modelcontextprotocol/sdk": "1.26.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "0.19.0",
    "@types/minimist": "1.2.5",
    "@types/node": "^25.2.3",
    "@types/turndown": "5.0.6",
    "@vitest/coverage-v8": "4.0.18",
    "minimist": "1.2.8",
    "playwright": "1.58.2",
    "rimraf": "6.1.3",
    "tsx": "4.21.0",
    "turndown": "7.2.2",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iress/design-system"
  },
  "stableVersion": "6.0.0-alpha.4"
}
