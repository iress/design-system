{
  "name": "@iress-oss/ids-theme-preset",
  "version": "6.0.0-beta.1",
  "description": "Panda CSS preset for the Iress Design System",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist coverage",
    "lint": "eslint . --ext=.js,.jsx,.ts,.tsx,.mjs,.cjs --max-warnings=0",
    "test": "vitest --config vitest.config.ts --watch",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json"
  },
  "dependencies": {
    "@iress-oss/ids-tokens": "^6.0.0-beta.1"
  },
  "peerDependencies": {
    "@pandacss/dev": ">=1.8.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@pandacss/dev": {
      "optional": false
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pandacss/dev": "1.9.1",
    "@pandacss/types": "1.9.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.2.0",
    "eslint-plugin-file-progress": "^4.0.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iress/design-system"
  },
  "stableVersion": "6.0.0-alpha.1"
}
